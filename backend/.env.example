# ========================================
# REAL-TIME OTP & EMAIL CONFIGURATION
# ========================================

# Email OTP via SendGrid (RECOMMENDED - 12,000 emails/month FREE)
# Sign up at: https://sendgrid.com/ (100% free tier, no credit card)
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# SMS/OTP Configuration (Optional - for phone-based OTP):

# Option 1: Twilio
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token  
# TWILIO_FROM_NUMBER=+1234567890

# Option 2: Fast2SMS (India)
# FAST2SMS_API_KEY=your_fast2sms_api_key

# Email Configuration for Password Reset (Gmail recommended)
# Gmail setup: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password_here
SMTP_SENDER=Ayu Disha <your_email@gmail.com>

# NOTE: If SendGrid/Gmail not configured, OTP/reset codes print to console
DEBUG=false
